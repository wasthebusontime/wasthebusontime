# Copy to /etc/wasthebusontime/collector.env (owner root, mode 600).
# This file holds secrets. Never commit the filled-in copy.

WBOT_DATA_DIR=/srv/wbot/data
# Alert when free space on the data disk falls below this percentage.
WBOT_DISK_MIN_FREE_PCT=10

# healthchecks.io ping URLs. Leave blank to disable a check.
WBOT_HC_COLLECTOR=
WBOT_HC_FEED_STALE=
WBOT_HC_PACK=
WBOT_HC_BACKUP=
WBOT_HC_STATIC=
WBOT_HC_DISK=

# Backblaze B2, through rclone. The remote is defined entirely by these
# variables, so no rclone config file is needed.
WBOT_B2_REMOTE=b2
WBOT_B2_BUCKET=
RCLONE_CONFIG_B2_TYPE=b2
RCLONE_CONFIG_B2_ACCOUNT=
RCLONE_CONFIG_B2_KEY=
