[Unit]
Description=Was the Bus On Time? static GTFS check
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/srv/wbot/data

[Service]
Type=oneshot
ExecStart=/opt/wbot/wasthebusontime/collector/.venv/bin/wbot-collector static
User=wbot
Group=wbot
EnvironmentFile=/etc/wasthebusontime/collector.env
WorkingDirectory=/opt/wbot/wasthebusontime/collector
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/srv/wbot/data /var/lib/wbot
