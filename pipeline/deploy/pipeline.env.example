# Copy to /etc/wasthebusontime/pipeline.env (owner root, mode 600).
# This file holds a secret (the healthcheck ping URL). Never commit the filled-in copy.

WBOT_DATA_DIR=/srv/wbot/data
WBOT_DERIVED_DIR=/srv/wbot/data/derived

# Publishing to the public stats repo. Off until the owner says go.
WBOT_PIPELINE_PUBLISH=0
WBOT_STATS_REPO=/var/lib/wbot/stats
# Deploy key with write access to the stats repo only.
WBOT_STATS_SSH_KEY=/var/lib/wbot/.ssh/stats_deploy

# healthchecks.io ping URL for the nightly run. Leave blank to disable.
WBOT_HC_PIPELINE=

# Methodology settings (provisional until re-validation). Defaults shown.
#WBOT_PIPELINE_FIRST_SERVICE_DATE=2026-10-04
#WBOT_PIPELINE_TRAILING_DAYS=3
#WBOT_PIPELINE_TRIP_COVERAGE_MIN=0.5
#WBOT_PIPELINE_MIN_SAMPLE=30
#WBOT_PIPELINE_GAP_TOLERANCE_S=840
#WBOT_PIPELINE_LOW_COMPLETENESS_BELOW=0.8
#WBOT_PIPELINE_PROVISIONAL=1
#WBOT_PIPELINE_METHODOLOGY_VERSION=1
# Earlier methodology changes to announce on the site, as date:version pairs.
#WBOT_PIPELINE_METHODOLOGY_CHANGES=
#WBOT_PIPELINE_DAILY_DAYS=90
