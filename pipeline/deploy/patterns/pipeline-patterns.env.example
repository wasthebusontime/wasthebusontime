# Copy to /etc/wasthebusontime/pipeline-patterns.env (owner root, mode 600) on VM 300.
# Settings for the patterns preview run (README.md here). It holds no secrets: no stats
# repo, no deploy key, no healthcheck URL.

WBOT_DATA_DIR=/srv/wbot/data
WBOT_DERIVED_DIR=/srv/wbot/data/derived-patterns

# Never publishes: preview forces publishing off in code, whatever WBOT_PIPELINE_PUBLISH says.
WBOT_PIPELINE_PREVIEW=1
WBOT_PIPELINE_PUBLISH=0

# Its own key, which VM 301 locks to /srv/wbot-patterns/private-stats.
WBOT_DEVCOPY_KEY=/var/lib/wbot/.ssh/devcopy-patterns
