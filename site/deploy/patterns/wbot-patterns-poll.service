# Variant of ../systemd/wbot-dev-poll.service for the patterns preview (README.md here).
[Unit]
Description=Was the Bus On Time? patterns preview (:8080): rebuild if the patterns branch or its data changed
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/srv/wbot-patterns/code/site/deploy/rebuild.sh
User=wbotdev
Group=wbotdev
Environment=HOME=/srv/wbot-patterns/state UV_CACHE_DIR=/srv/wbot-patterns/state/uv-cache UV_PYTHON_INSTALL_DIR=/srv/wbot-patterns/state/uv-python
Environment=WBOT_DEV_ROOT=/srv/wbot-patterns WBOT_CODE_BRANCH=patterns WBOT_STATS_URL= "WBOT_DEV_LABEL=PATTERNS PREVIEW"
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=15min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/srv/wbot-patterns
